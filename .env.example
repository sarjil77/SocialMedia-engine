# ──────────────────────────────────────────
# bakery-social-engine  — Environment Config
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# ── Telegram ──────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ── Google Gemini AI ──────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Meta / Instagram ─────────────────────
META_ACCESS_TOKEN=your-meta-long-lived-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-account-id

# ── Cloudinary (media hosting for Meta API)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Optional: TTS ─────────────────────────
TTS_PROVIDER=edge-tts
# EDGE_TTS_VOICE=hi-IN-SwaraNeural
EDGE_TTS_VOICE=gu-IN-DhwaniNeural

# ── App Settings ──────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/bakery.db
LOG_LEVEL=INFO
DEFAULT_SCHEDULE_HOUR=18
DEFAULT_SCHEDULE_MINUTE=0
ENABLE_VOICEOVER=true
